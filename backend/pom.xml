<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         DevNest 多模块根 POM(聚合 + 依赖/插件统一管理)
         任何版本号只在此处声明,子模块一律不写 <version>
         ============================================================ -->
    <groupId>com.devnest</groupId>
    <artifactId>devnest-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>devnest-parent</name>
    <description>DevNest 多模块聚合工程 - Spring Boot 3 + Java 21</description>

    <modules>
        <module>devnest-common</module>
        <module>devnest-core</module>
        <module>devnest-tunnel</module>
        <module>devnest-console</module>
        <module>devnest-datasource</module>
        <module>devnest-redis</module>
        <module>devnest-pipeline</module>
        <module>devnest-boot</module>
    </modules>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- 统一三方依赖版本(子模块不写 version) -->
        <jsch.version>0.2.16</jsch.version>
        <bcprov-jdk18on.version>1.77</bcprov-jdk18on.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok-mapstruct.version>0.2.0</lombok-mapstruct.version>
        <caffeine.version>3.1.8</caffeine.version>
        <okhttp.version>4.12.0</okhttp.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <!-- Redis Jedis:4.4.6 兼容 Java 21,Spring Boot BOM 未锁,自己管理 -->
        <jedis.version>4.4.6</jedis.version>
        <!-- 达梦 JDBC 驱动 8.x(DM8),Maven 中央无官方包,jar 放在 backend/lib/ 下,
             CI/本地构建前用 mvn install:install-file 安装到本地仓库 -->
        <dm-jdbc.version>8.1.3.140</dm-jdbc.version>
        <!-- Jackson 版本与 Spring Boot 3.2.5 自带一致(BOM 中 jackson-bom=2.15.4)
             自定义 blackbird 版本号与之一致,避免 NativeImageUtil 类不兼容 -->

        <!-- 模块边界强制:maven-enforcer-plugin 显式锁版本,不依赖 Spring Boot BOM 是否代为管理 -->
        <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>

        <!-- ===== P0 质量门禁:版本显式声明,不依赖父 POM 是否代为管理 ===== -->
        <jacoco-maven-plugin.version>0.8.11</jacoco-maven-plugin.version>
        <archunit.version>1.2.1</archunit.version>
        <owasp-dependency-check.version>12.1.0</owasp-dependency-check.version>

        <!-- 存量覆盖率地板(棘轮语义):只允许上调,不得下调.
             默认 0.00 = 该模块暂不设存量门禁(当前无测试的模块必然为 0,
             直接卡 60% 会让构建永久为红 → 见路线图 R2).
             有测试的模块在自己的 <properties> 里覆盖此值,取"实测值向下取整",
             使其成为"不许倒退"的地板;随测试补齐逐阶段向 60% 抬升. -->
        <jacoco.line.floor>0.00</jacoco.line.floor>

        <!-- 增量行覆盖门禁:只卡本次变更行,由 scripts/check-incremental-coverage.ps1 执行
             (本地/CI 同一份实现,见 .github/workflows/build-app.yml)。
             此处的属性是该脚本阈值的"单一事实来源",供 CI 与文档对齐 -->
        <jacoco.incremental.floor>0.80</jacoco.incremental.floor>

        <!-- 漏洞门禁:CVSS 达到该分数即构建失败 -->
        <owasp.fail-cvss>7</owasp.fail-cvss>
    </properties>

    <!-- 依赖版本锁定:子模块声明 <dependency> 时一律不用 <version> -->
    <dependencyManagement>
        <dependencies>
            <!-- ===== 业务模块内部依赖 ===== -->
            <dependency>
                <groupId>com.devnest</groupId>
                <artifactId>devnest-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devnest</groupId>
                <artifactId>devnest-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devnest</groupId>
                <artifactId>devnest-tunnel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devnest</groupId>
                <artifactId>devnest-console</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devnest</groupId>
                <artifactId>devnest-datasource</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devnest</groupId>
                <artifactId>devnest-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devnest</groupId>
                <artifactId>devnest-pipeline</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ===== SSH ===== -->
            <dependency>
                <groupId>com.github.mwiede</groupId>
                <artifactId>jsch</artifactId>
                <version>${jsch.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bcprov-jdk18on.version}</version>
            </dependency>

            <!-- ===== Redis ===== -->
            <dependency>
                <groupId>redis.clients</groupId>
                <artifactId>jedis</artifactId>
                <version>${jedis.version}</version>
            </dependency>

            <!-- ===== 达梦 DM8 JDBC(需要用户本地安装,可选) ===== -->
            <dependency>
                <groupId>com.dameng</groupId>
                <artifactId>DmJdbcDriver18</artifactId>
                <version>${dm-jdbc.version}</version>
            </dependency>

            <!-- ===== 对象映射 ===== -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- ===== 缓存 ===== -->
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>

            <!-- ===== HTTP 客户端 ===== -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>

            <!-- ===== 容错限流 ===== -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- 共享的编译插件配置:同时被所有子模块直接生效(不写 pluginManagement 避免每个子模块重复声明插件) -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <release>21</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- ============================================================
                 覆盖率门禁(P0 task 0.2)
                 prepare-agent:surefire 起 JVM 前注入探针,产出 target/jacoco.exec
                 report       :产出 HTML/XML/CSV 报告(存量覆盖率 = 观测指标)
                 check        :按 ${jacoco.line.floor} 卡下限(棘轮,只升不降)

                 注意:未跑测试的模块不会产生 jacoco.exec,report/check 会自动
                 跳过并打印 "Skipping JaCoCo execution due to missing execution
                 data file" —— 这是 JaCoCo 的既定行为,不是静默降级.
                 ============================================================ -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <rules>
                        <rule>
                            <element>BUNDLE</element>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>${jacoco.line.floor}</minimum>
                                </limit>
                            </limits>
                        </rule>
                    </rules>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <!-- 模块边界强制:统一声明版本与 enforce goal(绑定 validate 阶段).
                     各子模块只需给出自己的 <configuration>/<rules> 规则列表,
                     违规依赖会在编译前直接让构建失败. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>enforce-module-boundary</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                        </execution>
                    </executions>
                    <!-- 这里声明的规则对【所有子模块】生效(与子模块自己的 bannedDependencies 合并).
                         子模块只写各自差异化的依赖禁令,通用规则集中在此,避免 8 处重复. -->
                    <configuration>
                        <rules>
                            <!-- P0 task 0.3:同一个 artifact 在依赖树中出现多个版本即失败.
                                 目的:防止依赖被两条路径带进不同版本,导致运行期行为不确定 -->
                            <dependencyConvergence/>
                        </rules>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- ============================================================
         Profile: security-scan(P0 task 0.4 · 漏洞门禁)

         为什么是 profile 而不是无条件绑进 verify:
         OWASP dependency-check 每次运行都要先联网同步 NVD 漏洞库(首次数百 MB),
         把它焊死在 verify 上,本地每跑一次单测都要先等几分钟联网 —— 这种"看起来
         很严格"的门禁,结局必然是所有人习惯性地加 -Ddependency-check.skip=true,
         等于没有门禁(路线图风险 R2)。

         因此:本地默认不跑,CI 用 `-Psecurity-scan` 显式开启(见
         .github/workflows/build-app.yml)。

         为什么放在根 pom 而不是某个子模块:
         依赖漏洞是"整个依赖树"的属性。放在父 POM 会被所有子模块继承,每个模块
         各扫各的依赖树 —— 任何一处引入高危版本都会让构建在"引入它的那个模块"上
         变红,不会因为"恰好没人扫"而漏掉。

         ── 关于 NVD_API_KEY(实测结论,不是猜测)──────────────
         NVD 的 CVE 2.0 接口自 2023 年起对无凭据访问限速,实测在受限网络下直接
         返回 403;9.x 起插件已移除旧的 nvdDatafeed 批量源,只能走 API。三条路
         实测结果:
           · 9.0.9 + 无 key              -> 403,更新失败
           · 9.0.9 + nvdDatafeed        -> 参数已不存在(unknown parameter)
           · 8.4.3 + nvdDatafeed        -> 仍回落已下线的 1.1 源,403
         所以这条门禁的运行前提就是 NVD_API_KEY,没有"免 Key 的替代方案"。

         注意:更新失败会让构建失败(不是只告警)。这是一件好事 —— 它保证了
         门禁不会在"没扫成"的情况下假装绿色。既然结果是二元的,前提条件就必须
         被显式对待:CI 里该步骤在 NVD_API_KEY 缺失时会打印 warning 并在日志里
         明确写出"门禁未执行",而不是静默通过。

         阈值只由 ${owasp.fail-cvss} 决定(默认 7),要收紧/放宽请改这个属性。
         ============================================================ -->
    <profiles>
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${owasp-dependency-check.version}</version>
                        <configuration>
                            <failBuildOnCVSS>${owasp.fail-cvss}</failBuildOnCVSS>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <!-- NVD 的 CVE 2.0 接口自 2023 年起对无凭据访问限速,
                                 实测无 key 时直接 403,更新失败即构建失败(三条实测
                                 结论见下方 profile 注释)。
                                 key 从环境变量注入,不写进仓库;本地要跑这个 profile
                                 请先设好 NVD_API_KEY,否则这次扫描必然红。 -->
                            <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                            <!-- 本工程只有 Java。关掉 .NET / JS / Node 三类分析器:
                                 既省一轮无谓扫描,也少掉三个外部数据源(RetireJS
                                 的 jsrepository.json 托管在 raw.githubusercontent.com,
                                 在受限网络里会让整次扫描直接失败)。 -->
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                        </configuration>
                        <executions>
                            <execution>
                                <id>owasp-dependency-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
