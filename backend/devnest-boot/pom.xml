<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.devnest</groupId>
        <artifactId>devnest-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>devnest-boot</artifactId>
    <name>devnest-boot</name>
    <description>启动模块 - 唯一可执行 jar;依赖所有业务子模块并加载配置/Flyway</description>

    <dependencies>
        <!-- 业务层全部依赖 -->
        <dependency>
            <groupId>com.devnest</groupId>
            <artifactId>devnest-tunnel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devnest</groupId>
            <artifactId>devnest-console</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devnest</groupId>
            <artifactId>devnest-datasource</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devnest</groupId>
            <artifactId>devnest-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devnest</groupId>
            <artifactId>devnest-pipeline</artifactId>
        </dependency>

        <!-- 数据库驱动(按 profile 切换) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 达梦 DM8 JDBC:通过 profile 条件化加载,CI 构建时用 -DskipDm 跳过 -->

        <!-- 数据库迁移 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Actuator(health/info,其余端点关闭) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Boot DevTools(仅本地) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================
             架构守护(P0 task 0.5)
             为什么放在 boot 的 test 源集:ArchUnit 需要"看见全部模块的类",
             而 boot 是唯一依赖了所有业务模块的模块,天然具备完整 classpath.
             无需为此新增一个只为测试存在的模块.
             ============================================================ -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================
             集成测试基座(P0 task 0.6):用真实 MySQL 8 / Redis 容器跑,
             替代 H2 内存库 —— 消除"测试绿"推不出"生产没问题"的方言分裂.
             Docker 不可用时由 @EnabledIfDockerAvailable 显式跳过(不是静默降级).
             ============================================================ -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Redis 没有独立的 testcontainers 模块,用 core 的 GenericContainer -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 唯一可执行 jar:用 spring-boot-maven-plugin repackage -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 编译器(复用 parent pluginManagement 配置) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- ============================================================
         Profile: dm-driver
         达梦 DM8 JDBC 驱动不在 Maven 中央仓库,需用户本地 install
         CI 构建时用 -DskipDm 激活默认 profile 跳过
         ============================================================ -->
    <profiles>
        <profile>
            <id>dm-driver</id>
            <activation>
                <property>
                    <name>!skipDm</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.dameng</groupId>
                    <artifactId>DmJdbcDriver18</artifactId>
                    <optional>true</optional>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
