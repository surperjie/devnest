<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.devnest</groupId>
        <artifactId>devnest-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>devnest-datasource</artifactId>
    <name>devnest-datasource</name>
    <description>数据库可视化模块 - 数据源管理/库表结构/数据预览/SQL编辑器/AI-SQL</description>

    <dependencies>
        <dependency>
            <groupId>com.devnest</groupId>
            <artifactId>devnest-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <!-- MySQL JDBC 驱动(业务数据源连接用) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- 单元测试:守护"配置变更丢弃旧连接池"这类容易回归的行为 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ============================================================
         模块边界强制(validate 阶段,违规即构建失败)
         依赖方向:common ← core ← {tunnel, console, datasource, redis, pipeline} ← boot
         业务模块之间禁止横向依赖,隧道能力一律走 core.spi 接口
         ============================================================ -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <configuration>
                    <rules>
                        <bannedDependencies>
                            <excludes>
                                <exclude>com.devnest:devnest-tunnel</exclude>
                                <exclude>com.devnest:devnest-console</exclude>
                                <exclude>com.devnest:devnest-redis</exclude>
                                <exclude>com.devnest:devnest-pipeline</exclude>
                                <exclude>com.devnest:devnest-boot</exclude>
                            </excludes>
                        </bannedDependencies>
                    </rules>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
