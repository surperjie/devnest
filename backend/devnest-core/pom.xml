<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.devnest</groupId>
        <artifactId>devnest-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>devnest-core</artifactId>
    <name>devnest-core</name>
    <description>领域基础层 - BaseEntity/JPA配置/统一线程池/缓存/HTTP/连接池工厂/SPI接口</description>

    <dependencies>
        <dependency>
            <groupId>com.devnest</groupId>
            <artifactId>devnest-common</artifactId>
        </dependency>

        <!-- JPA 持久化:BaseEntity 依赖 spring-data-jpa + Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Cache + Caffeine 集成 (@Cacheable 可用) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- OkHttp 统一 HTTP 客户端 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

        <!-- HikariCP (Spring Boot JDBC starter 自带) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Micrometer:给 HikariPoolFactory 导出指标,boot 模块 actuator 会完整引入 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- Jackson 字节码加速 -->
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-blackbird</artifactId>
        </dependency>

        <!-- 单元测试:用 H2 内存库跑真实 Hikari,验证连接池生命周期与数量闸门 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ============================================================
         模块边界强制(validate 阶段,违规即构建失败)
         依赖方向:common ← core ← {tunnel, console, datasource, redis, pipeline} ← boot
         core 只允许依赖 common;禁止反向依赖业务模块,也禁止依赖 boot
         ============================================================ -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <configuration>
                    <rules>
                        <bannedDependencies>
                            <excludes>
                                <exclude>com.devnest:devnest-tunnel</exclude>
                                <exclude>com.devnest:devnest-console</exclude>
                                <exclude>com.devnest:devnest-datasource</exclude>
                                <exclude>com.devnest:devnest-redis</exclude>
                                <exclude>com.devnest:devnest-pipeline</exclude>
                                <exclude>com.devnest:devnest-boot</exclude>
                            </excludes>
                        </bannedDependencies>
                    </rules>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
