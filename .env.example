# DevNest 本地配置模板
#
# 用法:复制本文件为同目录下的 .env,取消需要的行注释并填写,再启动后端.
#       .env 已被 .gitignore 忽略,不会进仓库.
#
# 原理:后端 application.yml 里配置了
#         spring.config.import: optional:file:./.env[.properties]
#       因此这里的变量等价于系统环境变量,无需在 PowerShell 里手动 $env: 赋值.
#       文件不存在时静默跳过,不影响默认启动.

# ---- 服务监听 ----
# 默认仅绑回环(127.0.0.1),杜绝局域网/外网暴露;部署到服务器时按需放开,如 0.0.0.0
#DEVNEST_SERVER_ADDRESS=127.0.0.1

# ---- prod profile 配置库(MySQL) ----
# prod profile 下三项凭据均从环境变量读取,密码无默认值,必须显式提供
#DEVNEST_DB_URL=jdbc:mysql://localhost:3306/dev_nest?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
#DEVNEST_DB_USERNAME=root
#DEVNEST_DB_PASSWORD=
